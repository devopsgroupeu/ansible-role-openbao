{#
  env_quote follows the double-quote grammar of systemd EnvironmentFile=
  (systemd.exec(5)): the value is wrapped in double quotes and \ " ` $ are
  escaped with a backslash. Line breaks and NUL are rejected by validate.yml.
#}
{% macro env_quote(value) -%}
"{{ value | string | replace('\\', '\\\\') | replace('"', '\\"') | replace('`', '\\`') | replace('$', '\\$') }}"
{%- endmacro %}
# Managed by Ansible - do not edit manually.
# Changes to this file will be overwritten on the next playbook run.
# EnvironmentFile of openbao.service, read by systemd only. It must always
# exist (a missing EnvironmentFile is a hard unit failure). Never source it
# into a shell: the bao CLI would pick up BAO_TOKEN.
{% if openbao_enable_file_permissions_check | bool %}
BAO_ENABLE_FILE_PERMISSIONS_CHECK={{ env_quote('true') }}
{% endif %}
{% if openbao_seal_type == 'transit' and openbao_seal_transit_token %}
BAO_TOKEN={{ env_quote(openbao_seal_transit_token) }}
{% endif %}
{% if openbao_seal_type == 'awskms' and openbao_seal_awskms_access_key %}
AWS_ACCESS_KEY_ID={{ env_quote(openbao_seal_awskms_access_key) }}
{% endif %}
{% if openbao_seal_type == 'awskms' and openbao_seal_awskms_secret_key %}
AWS_SECRET_ACCESS_KEY={{ env_quote(openbao_seal_awskms_secret_key) }}
{% endif %}
{% if openbao_seal_type == 'azurekeyvault' and openbao_seal_azurekeyvault_client_secret %}
AZURE_CLIENT_SECRET={{ env_quote(openbao_seal_azurekeyvault_client_secret) }}
{% endif %}
{% if openbao_seal_type == 'static' %}
OPENBAO_SEAL_STATIC_CURRENT_KEY={{ env_quote(openbao_seal_static_current_key) }}
{% endif %}
